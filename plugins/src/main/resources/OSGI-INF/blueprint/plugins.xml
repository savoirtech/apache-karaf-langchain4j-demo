<blueprint
        xmlns:cm="http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
        xsi:schemaLocation="http://www.osgi.org/xmlns/blueprint/v1.0.0
        http://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd">

    <cm:property-placeholder persistent-id="com.savoir.apache.karaf.ai.gateway.plugins" update-strategy="reload">
        <cm:default-properties>
            <!-- Default values if no plugins config in etc folder -->
            <cm:property name="llama_address" value="http://127.0.0.1:11434"/>
            <cm:property name="mistral_address" value="http://127.0.0.1:11434"/>
            <!--
            <cm:property name="fast_lane_address" value="http://127.0.0.1:11434"/>
            <cm:property name="slow_lane_address" value="http://127.0.0.1:11434"/>
            -->
        </cm:default-properties>
    </cm:property-placeholder>

    <reference id="knowledgeBase" interface="com.savoir.apache.karaf.ai.gateway.impl.AIKnowledgeBase"/>

    <bean id="demoPlugin" class="com.savoir.apache.karaf.ai.gateway.plugins.DemoPlugin"/>

    <service ref="demoPlugin" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="demo"/>
        </service-properties>
    </service>

    <bean id="openai" class="com.savoir.apache.karaf.ai.gateway.plugins.OpenAiChatSimplePrompt"/>

    <service ref="openai" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="openai"/>
        </service-properties>
    </service>

    <bean id="llama" class="com.savoir.apache.karaf.ai.gateway.plugins.OllamaAiChatSimplePrompt">
        <argument value="llama3.2"/>
        <argument value="${llama_address}"/>
    </bean>

    <service ref="llama" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="llama"/>
        </service-properties>
    </service>

    <bean id="mistral" class="com.savoir.apache.karaf.ai.gateway.plugins.OllamaAiChatSimplePrompt">
        <argument value="mistral"/>
        <argument value="${mistral_address}"/>
    </bean>

    <service ref="mistral" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="mistral"/>
        </service-properties>
    </service>

    <!--
    <bean id="fastlane" class="com.savoir.apache.karaf.ai.gateway.plugins.OllamaAiChatSimplePrompt">
        <argument value="llama3.2"/>
        <argument value="${fast_lane_address}"/>
    </bean>

    <service ref="fastlane" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="fastlane"/>
        </service-properties>
    </service>

    <bean id="slowlane" class="com.savoir.apache.karaf.ai.gateway.plugins.OllamaAiChatSimplePrompt">
        <argument value="llama3.2"/>
        <argument value="${slow_lane_address}"/>
