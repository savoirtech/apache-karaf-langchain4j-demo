<blueprint
        xmlns:cm="http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
        xsi:schemaLocation="http://www.osgi.org/xmlns/blueprint/v1.0.0
        http://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd">


    <reference id="knowledgeBase" interface="com.savoir.apache.karaf.ai.gateway.impl.AIKnowledgeBase"/>

    <bean id="demoPlugin" class="com.savoir.apache.karaf.ai.gateway.plugins.DemoPlugin"/>

    <service ref="demoPlugin" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="demo"/>
        </service-properties>
    </service>

    <bean id="openAiChatSimplePrompt" class="com.savoir.apache.karaf.ai.gateway.plugins.OpenAiChatSimplePrompt"/>

    <service ref="openAiChatSimplePrompt" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="openAiChatSimplePrompt"/>
        </service-properties>
    </service>

    <bean id="llama32" class="com.savoir.apache.karaf.ai.gateway.plugins.OllamaAiChatSimplePrompt">
        <argument value="llama3.2"/>
        <argument value="http://127.0.0.1:11434"/>
    </bean>

    <service ref="llama32" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="llama32"/>
        </service-properties>
    </service>

    <bean id="mistral" class="com.savoir.apache.karaf.ai.gateway.plugins.OllamaAiChatSimplePrompt">
        <argument value="mistral"/>
        <argument value="http://127.0.0.1:11434"/>
    </bean>

    <service ref="mistral" interface="com.savoir.apache.karaf.ai.gateway.spi.ExecutorPlugin">
        <service-properties>
            <entry key="pluginType" value="mistral"/>
        </service-properties>
    </service>

